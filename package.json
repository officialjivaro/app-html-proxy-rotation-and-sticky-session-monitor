{
  "name": "aerod-proxy-rotation-sticky-session-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "type-check": "vue-tsc -b && tsc -p worker-proxy-rotation-monitor/tsconfig.json --noEmit",
