{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "worker-proxy-rotation-monitor",
  "main": "worker-proxy-rotation-monitor/src/index.ts",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMITS", "class_name": "ProxyRateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProxyRateLimiter"] }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
